# ─── Application ─────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_NAME=zplus-calendar

# ─── PostgreSQL ──────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=zplus
POSTGRES_PASSWORD=zplus_secret_2024
POSTGRES_DB=zplus_calendar
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_MAX_IDLE_CONNS=5

# ─── MongoDB ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://zplus:zplus_secret_2024@localhost:27017
MONGO_DB=zplus_calendar

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000

# ─── Upload ──────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# ─── SMTP (optional) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@zplus-calendar.com
